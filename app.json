{
  "expo": {
    "name": "Stellibria",
    "slug": "stellibria",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stellibria",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C1322",
    "ios": {
      "bundleIdentifier": "com.stellibria.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.stellibria.app",
      "adaptiveIcon": {
        "backgroundColor": "#0C1322",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0C1322",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Stellibria reads the text of a page you choose, on your phone, so you can quote a few lines in your journal. The photo is not kept.",
          "cameraPermission": "Stellibria reads the text of a page you photograph, on your phone, so you can quote a few lines in your journal. The photo is not kept.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#86CDBE"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Stellibria uses the camera to read the barcode on a book, so it can find your edition. Nothing is photographed or kept.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
